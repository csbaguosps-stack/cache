<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow access to actual files and directories (css, js, icons, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else to index.php
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>

# Security: Deny direct access to config/settings.json
<Files "settings.json">
    Order allow,deny
    Deny from all
</Files>
